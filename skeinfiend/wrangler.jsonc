{
  // The app and its API as one Cloudflare Worker: pages from the built assets, /api from worker/index.ts.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skeinfiend",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-20",
  // pg needs Node's APIs (sockets, crypto), which Workers provide with this flag.
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  // Cloudflare's pooled connection to PlanetScale (made by the PlanetScale integration; caching off, so
  // sign-in never reads a stale session). Locally, the Postgres `npm run dev` starts instead (it takes any
  // password; one is only there because Wrangler insists on it).
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "eb9594cb8aaf43baa4ce9f744c2d36b8",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/skeinfiend"
    }
  ],
  // Its own address, on Cloudflare: deploying keeps the domain pointed here.
  "routes": [
    {
      "pattern": "skeinfiend.com",
      "custom_domain": true
    }
  ],
  // Only there: sign-in works on one address, so the workers.dev one is off.
  "workers_dev": false,
  "preview_urls": false
}
