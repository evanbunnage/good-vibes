# Copy to .env for local development. Deployed, the secrets are set with `npx wrangler secret put <NAME>`.

# Postgres as the app's role, which reads and writes rows.
DATABASE_URL=
# Postgres as a role that can create tables, for `npm run db:migrate`.
DEFAULT_DATABASE_URL=
# The Hyperdrive binding's local stand-in: the same as DATABASE_URL.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=

# Signs sign-in sessions: a long random string (openssl rand -base64 32). Use a different one deployed.
BETTER_AUTH_SECRET=
# Where the dev server runs.
BETTER_AUTH_URL=http://localhost:5173

# Resend, for password reset emails. A sending-only key is enough.
RESEND_API_KEY=
# Optional: who emails are from, on a domain verified in Resend.
EMAIL_FROM=
